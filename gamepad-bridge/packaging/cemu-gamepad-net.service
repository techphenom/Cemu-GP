# The GamePad's network on the RT5572 (scripts/pad-net.sh, SERVICE=1). Started by udev whenever the adapter is
# plugged in (70-cemu-gamepad.rules), also at boot; stops on its own when it's unplugged. Installed by
# scripts/install-system.sh, which fills in @DEST@. Logs: journalctl -u cemu-gamepad-net, /var/log/cemu-gamepad/
[Unit]
Description=Wii U GamePad network (RT5572 access point)
# iwd: at boot, iwd must be up before pad-net.sh looks for it (or it takes the adapter from a running network)
After=NetworkManager.service firewalld.service iwd.service
Wants=NetworkManager.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Environment=SERVICE=1
ExecStart=@DEST@/scripts/pad-net.sh
# pad-net.sh hands the adapter back (NetworkManager, firewall, MAC) itself on SIGTERM; only then the rest
KillMode=mixed
TimeoutStopSec=20
Restart=on-failure
RestartSec=5
