# Build environment for the Cemu + GamePad bridge AppImage (fork). Ubuntu 22.04, as upstream's CI: an AppImage
# runs on systems with this glibc or newer (SteamOS included). Used by dist/linux/build-appimage.sh.
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
	# Cemu (upstream CI's list, plus what its runner image has preinstalled: llvm-15 for llvm-ar, used with LTO)
	clang-15 llvm-15 freeglut3-dev libgcrypt20-dev libglm-dev libgtk-3-dev libpulse-dev libsecret-1-dev libsystemd-dev \
	libudev-dev nasm ninja-build libbluetooth-dev libusb-1.0-0-dev appstream \
	build-essential git curl ca-certificates zip unzip tar pkg-config python3 python3-pip autoconf automake \
	libtool bison flex file \
	libx11-dev libxext-dev libxrandr-dev libxcursor-dev libxi-dev libxss-dev libxinerama-dev libxkbcommon-dev \
	libwayland-dev wayland-protocols libegl1-mesa-dev libgl1-mesa-dev libdbus-1-dev libdecor-0-dev \
	# GamePad bridge (gamepad-bridge/README.md): drc-x264, libdrc, drc-hostap, the bridge
	g++-12 gcc-12 yasm patch rsync libnl-3-dev libnl-genl-3-dev libnl-route-3-dev libssl-dev \
	libavutil-dev libswscale-dev \
	# bundled into the AppImage (dist/linux/bundle-gamepad.sh)
	iw dnsmasq-base ethtool patchelf \
	&& rm -rf /var/lib/apt/lists/*
# The bridge is C++20: GCC 12 rather than 22.04's GCC 11. Cemu itself builds with clang-15, as upstream.
RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 100 \
	&& update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-12 100 \
	&& update-alternatives --install /usr/bin/cc cc /usr/bin/gcc-12 100 \
	&& update-alternatives --install /usr/bin/c++ c++ /usr/bin/g++-12 100
# 22.04's CMake (3.22) is older than vcpkg's ports want; upstream's runners have a current one. Not 4.x: it
# refuses 22.04's glm config (cmake_minimum_required < 3.5).
RUN pip3 install --no-cache-dir 'cmake>=3.30,<4'
